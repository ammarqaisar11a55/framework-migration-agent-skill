{
  "root": true,
  "env": { "node": true, "es2022": true },
  "extends": "eslint:recommended",
  "rules": {
    "eqeqeq": "error",
    "no-unused-vars": ["error", { "args": "none" }]
  },
  "overrides": [
    {
      "files": ["test/**/*.js"],
      "rules": { "no-unused-expressions": "error" }
    }
  ]
}
