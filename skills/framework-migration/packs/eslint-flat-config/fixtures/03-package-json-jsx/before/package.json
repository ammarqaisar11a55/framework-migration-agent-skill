{
  "name": "fixture-package-json-jsx",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint --ext .js,.jsx src",
    "test": "node --test test/*.test.js"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true,
      "es2022": true
    },
    "parserOptions": {
      "ecmaVersion": 2022,
      "ecmaFeatures": {
        "jsx": true
      }
    },
    "extends": "eslint:recommended",
    "rules": {
      "no-console": "error"
    }
  },
  "devDependencies": {
    "eslint": "8.57.1"
  }
}
