{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ammarqaisar11a55/framework-migration-agent-skill/schemas/rules.schema.json",
  "title": "Deprecated-API rule file (rules/deprecated-apis.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["rules"],
  "definitions": {
    "exclude": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "description": "Regular expressions matched against the project-relative path (forward slashes). Matching files are not scanned."
    }
  },
  "properties": {
    "exclude": { "$ref": "#/definitions/exclude", "description": "Applies to every rule in the file: files the pack's codemods do not touch." },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "matcher", "severity", "auto_fixable", "fix_hint", "docs_url"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "description": { "type": "string", "minLength": 1 },
          "matcher": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "pattern"],
                "properties": {
                  "type": { "const": "regex" },
                  "pattern": { "type": "string", "minLength": 1 },
                  "flags": { "type": "string", "pattern": "^[imsu]*$" }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "selector"],
                "properties": {
                  "type": { "const": "ast" },
                  "selector": { "type": "string", "minLength": 1, "description": "esquery selector over the ESTree AST (JS/TS only)." }
                }
              }
            ]
          },
          "extensions": { "type": "array", "items": { "type": "string", "pattern": "^\\." }, "description": "File extensions the rule applies to. Defaults to the ecosystem's source extensions." },
          "exclude": { "$ref": "#/definitions/exclude" },
          "skip_explicit_commonjs": { "type": "boolean", "description": "Node: skip .cjs files and files under a nested package.json (below the project root) with \"type\": \"commonjs\" — code a migration deliberately keeps CommonJS." },
          "severity": { "enum": ["info", "warn", "error"] },
          "auto_fixable": { "type": "boolean" },
          "fix_hint": { "type": "string", "minLength": 1 },
          "docs_url": { "type": "string", "pattern": "^https://" }
        }
      }
    }
  }
}
