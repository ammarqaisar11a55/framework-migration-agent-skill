{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ammarqaisar11a55/framework-migration-agent-skill/schemas/findings.schema.json",
  "title": "Rule findings (findings.json)",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack", "findings"],
  "properties": {
    "pack": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "severity", "auto_fixable", "file", "line", "column", "excerpt", "fix_hint", "docs_url"],
        "properties": {
          "rule": { "type": "string" },
          "severity": { "enum": ["info", "warn", "error"] },
          "auto_fixable": { "type": "boolean" },
          "file": { "type": "string" },
          "line": { "type": "integer", "minimum": 1 },
          "column": { "type": "integer", "minimum": 1 },
          "excerpt": { "type": "string" },
          "fix_hint": { "type": "string" },
          "docs_url": { "type": "string" }
        }
      }
    }
  }
}
