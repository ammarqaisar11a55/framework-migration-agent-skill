{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/ammarqaisar11a55/framework-migration-agent-skill/schemas/pack.schema.json",
  "title": "Migration pack manifest (pack.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "ecosystem",
    "tier",
    "status",
    "from",
    "to",
    "tools",
    "stages",
    "checks"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "Must equal the pack directory name."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "ecosystem": {
      "enum": [
        "node",
        "python",
        "jvm",
        "dotnet",
        "php",
        "ruby",
        "dart",
        "go"
      ]
    },
    "tier": {
      "enum": [
        1,
        2,
        3
      ],
      "description": "1 = automate, 2 = partial, 3 = assist mode."
    },
    "status": {
      "enum": [
        "planned",
        "in progress",
        "shipped"
      ],
      "description": "Shipped packs must have at least 3 positive and 1 negative fixture."
    },
    "from": {
      "$ref": "#/definitions/stack"
    },
    "to": {
      "$ref": "#/definitions/stack"
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^v?[0-9]+\\.[0-9]+(\\.[0-9]+)?([.+-][0-9A-Za-z.+-]+)?$",
            "description": "Exact version. Ranges (^, ~, x, >=) and placeholders are rejected."
          },
          "source": {
            "type": "string",
            "pattern": "^https://",
            "description": "Repository the tool is fetched from, for tools run from source rather than installed from a registry."
          },
          "ref": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$",
            "description": "Full commit SHA of `source` the pack was verified with."
          },
          "role": {
            "enum": [
              "dependency",
              "devDependency",
              "engine"
            ],
            "description": "dependency/devDependency tools are added to the target project; engine tools are used by the pack's codemods."
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "title": {
            "type": "string"
          },
          "codemods": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "File names in codemods/, run in order."
          },
          "commands": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/command"
            },
            "description": "Run before the stage's codemods: the official migration tool goes here. `{pack_dir}` is replaced with the pack's directory."
          },
          "fix_rules": {
            "type": "boolean",
            "description": "Stage addresses auto_fixable findings."
          },
          "post_commands": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/command"
            },
            "description": "Run after the stage's codemods are applied (e.g. a dependency install)."
          }
        }
      }
    },
    "checks": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "typecheck": {
          "type": "string"
        },
        "test": {
          "type": "string"
        },
        "lint": {
          "type": "string"
        },
        "smoke": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "description": "Command that exits 0 when the app boots."
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "url"
              ],
              "properties": {
                "start": {
                  "type": "string",
                  "minLength": 1,
                  "description": "Command that starts the app. PORT is set to a free port."
                },
                "url": {
                  "type": "string",
                  "pattern": "^https?://",
                  "description": "Probed until it answers with a status below 500. {port} is replaced with the chosen port."
                },
                "timeout_ms": {
                  "type": "integer",
                  "minimum": 1000
                }
              }
            }
          ]
        }
      }
    }
  },
  "definitions": {
    "stack": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "framework",
        "versions"
      ],
      "properties": {
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 1
        },
        "versions": {
          "type": "string",
          "minLength": 1,
          "description": "semver range, e.g. \"4.x\"."
        },
        "module_type": {
          "enum": ["commonjs", "module"],
          "description": "Node packs only: the package's module format (package.json \"type\") must match."
        }
      }
    },
    "command": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "description": "Shell command with no preview mode; --dry-run lists it without running it."
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "run",
            "dry_run"
          ],
          "properties": {
            "run": {
              "type": "string",
              "minLength": 1
            },
            "dry_run": {
              "type": "string",
              "minLength": 1,
              "description": "Variant of the command that only reports what it would change."
            }
          }
        }
      ]
    }
  }
}
